# --- Web ---
PORT=8080
# Public URL of the dashboard (used in /dashboard replies). No trailing slash.
PUBLIC_URL=http://localhost:8080
# Long random string. Signs daily access keys + sessions. REQUIRED in production.
APP_SECRET=change-me-to-a-long-random-string
# Bearer token for the admin HTTP API (add slips, rotate key). Optional.
ADMIN_TOKEN=
# Timezone that defines the group's "day" (key rotation, tonight's poster).
GROUP_TZ=America/Chicago
# SQLite file location (on Railway mount a volume at /data and use /data/picks.db)
DATABASE_PATH=./data/picks.db
# Leagues the resolver searches when a pick doesn't name one
LEAGUES=nba,nfl,nhl,mlb,ncaaf,ncaab,wnba

# --- Discord (optional; web runs without it) ---
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=
# Register slash commands instantly to one server (else global, can take up to 1h)
DISCORD_GUILD_ID=
# Comma-separated Discord role IDs treated as admins (Manage Server always counts)
DISCORD_ADMIN_ROLE_IDS=

# --- Demo ---
# 1 = seed clearly-labelled demo slips on real ESPN games and write demo key to data/demo-access-key.txt
DEMO_MODE=0
