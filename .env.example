# --- Web ---
PORT=8080
# Public URL of the dashboard (used in /dashboard replies). No trailing slash.
PUBLIC_URL=http://localhost:8080
# Long random string. Signs daily access keys + sessions. REQUIRED in production.
APP_SECRET=change-me-to-a-long-random-string
# Bearer token for the admin HTTP API (add slips, rotate key). Optional.
ADMIN_TOKEN=
# Timezone that defines the group's "day" (key rotation, tonight's poster).
GROUP_TZ=America/Chicago
# Name shown in bot embeds (dashboard title, board title).
GROUP_NAME=Lelouch HQ
# Nickname the bot sets for itself in each server on ready. Does not change the global username.
BOT_NICKNAME=Lelouch HQ
# SQLite file location (on Railway mount a volume at /data and use /data/picks.db)
DATABASE_PATH=./data/picks.db
# Optional Postgres (e.g. Neon) URL: snapshot SQLite there + restore on boot (survives ephemeral disks)
DATABASE_URL=
# Leagues the resolver searches when a pick doesn't name one
LEAGUES=nba,nfl,nhl,mlb,ncaaf,ncaab,wnba
# Discord channel id for graded-result posts. Blank = find a channel whose name contains layup-feed.
LAYUP_FEED_CHANNEL_ID=
# Tier ladder, lowest first. Blank = free:Free Member,moneyline:Moneyline,vip:VIP,deluxe:Deluxe,lifetime:Lifetime
TIER_LADDER=
# Role names that see every tier. Blank = Admin, Moderator, Analyst Mods, Support
STAFF_ROLE_NAMES=
# Weekly board boundary. monday (default) or sunday.
WEEK_START=monday

# --- Discord (optional; web runs without it) ---
DISCORD_BOT_TOKEN=
DISCORD_APP_ID=
# Register slash commands instantly to one server (else global, can take up to 1h)
DISCORD_GUILD_ID=
# Comma-separated Discord role IDs treated as admins (Manage Server always counts)
DISCORD_ADMIN_ROLE_IDS=

# --- Edge Engine (optional). Both email and password must be set or /edge stays off. Never commit real values.
EDGE_EMAIL=
EDGE_PASSWORD=
# Comma-separated channel IDs. Slip screenshots here are rated from Edge and are NOT logged to the board.
EDGE_CHANNEL_IDS=
# Minutes before the in-memory board is stale. Default 12. A refresh also waits at least 1 minute between tries.
EDGE_CACHE_TTL_MIN=12
# Optional override. Default https://edge-engine.up.railway.app
# EDGE_ORIGIN=

# --- Demo ---
# 1 = seed clearly-labelled demo slips on real ESPN games and write demo key to data/demo-access-key.txt
DEMO_MODE=0
